{
  "name": "@cfasim-ui/components",
  "version": "0.8.3",
  "type": "module",
  "description": "Vue 3 UI components for cfasim-ui",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDCgov/cfa-simulator.git",
    "directory": "cfasim-ui/components"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "node ../../scripts/generate_docs.mjs"
  },
  "dependencies": {
    "@cfasim-ui/shared": "workspace:*",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/view": "6.43.6",
    "codemirror": "6.0.2",
    "reka-ui": "2.10.1",
    "smol-toml": "1.7.0",
    "vue-codemirror": "6.1.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.45.8",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.10.6",
    "vite-plugin-dts": "5.0.3",
    "vite-svg-loader": "5.1.1",
    "vitest": "4.1.10"
  }
}
