{
  "name": "@cfasim-ui/components",
  "version": "0.17.0",
  "type": "module",
  "description": "Vue 3 UI components for cfasim-ui",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDCgov/cfa-simulator.git",
    "directory": "cfasim-ui/components"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.csv"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cfasim-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "node ../../scripts/generate_docs.mjs"
  },
  "dependencies": {
    "@cfasim-ui/shared": "workspace:*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@internationalized/date": "3.12.4",
    "reka-ui": "2.10.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.49.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "happy-dom": "21.0.4",
    "vite-plugin-dts": "5.1.2",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.1.1"
  }
}
