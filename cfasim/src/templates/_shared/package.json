{
  "name": "{{ project_name }}",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.35",
    "cfasim-ui": "^{{ cfasim_version }}"
  },
  "devDependencies": {
    "@cfasim-ui/docs": "^{{ cfasim_version }}",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vue-tsc": "^3.3.2"
  }
}
